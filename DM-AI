<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DM-AI</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #111111;
            color: white;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            padding: 20px 30px;
            font-size: 24px;
            font-weight: bold;
            border-bottom: 1px solid #2a2a2a;
        }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #999;
            margin-bottom: 35px;
            font-size: 18px;
        }

        .chat-box {
            width: 100%;
            max-width: 700px;
            background: #1c1c1c;
            border: 1px solid #333;
            border-radius: 16px;
            padding: 15px;
        }

        textarea {
            width: 100%;
            height: 120px;
            background: transparent;
            border: none;
            outline: none;
            color: white;
            font-size: 16px;
            resize: none;
        }

        textarea::placeholder {
            color: #777;
        }

        .bottom {
            display: flex;
            justify-content: flex-end;
        }

        button {
            background: white;
            color: black;
            border: none;
            border-radius: 10px;
            padding: 12px 20px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #dddddd;
        }
    </style>
</head>

<body>

<header>
    ⚔️ DM-AI
</header>

<main>

    <h1>What do you want to create?</h1>

    <p class="subtitle">
        Build your D&D campaign with AI.
    </p>

    <div class="chat-box">

        <textarea
            id="prompt"
            placeholder="Describe the campaign you want...">
        </textarea>

        <div class="bottom">
            <button onclick="generateCampaign()">
                Generate
            </button>
        </div>

    </div>

</main>

<script>

function generateCampaign() {

    const prompt = document.getElementById("prompt").value;

    if (prompt.trim() === "") {
        alert("Tell DM-AI what you want to create!");
        return;
    }

    alert("DM-AI will generate your campaign here!");

}

</script>

</body>
</html>
